local function isSameTeam(plr)
	if not plr or plr == player then return false end
	if player.Team and plr.Team then
		return player.Team == plr.Team
	end
	if player.TeamColor and plr.TeamColor and player.TeamColor ~= BrickColor.White() then
		if player.TeamColor == plr.TeamColor then
			return true
		end
	end
	local myAttrTeam = player:GetAttribute("Team") or player:GetAttribute("TeamName") or player:GetAttribute("Faction")
	local theirAttrTeam = plr:GetAttribute("Team") or plr:GetAttribute("TeamName") or plr:GetAttribute("Faction")
	if myAttrTeam ~= nil and theirAttrTeam ~= nil and tostring(myAttrTeam) == tostring(theirAttrTeam) then
		return true
	end
	local myChar = player.Character
	local theirChar = plr.Character
	if myChar and theirChar then
		local myHl = myChar:FindFirstChildOfClass("Highlight")
		local theirHl = theirChar:FindFirstChildOfClass("Highlight")
		if myHl and theirHl and myHl.FillColor == theirHl.FillColor then
			return true
		end
	end
	if #Teams:GetTeams() > 0 then
		for _, tm in ipairs(Teams:GetTeams()) do
			if tm == player.Team and tm == plr.Team then
				return true
			end
		end
	end
	return false
end

local function isEnemyForEsp(plr)
	if not plr or plr == player then return false end
	if state.teamCheck and isSameTeam(plr) then
		return false
	end
	return true
end

local function isEnemyForAim(plr)
	if not plr or plr == player then return false end
	if state.aimTeamCheck and isSameTeam(plr) then
		return false
	end
	return true
end

local function applyThirdPersonHack()
	if state.thirdPersonHack then
		player.CameraMinZoomDistance = math.max(state.thirdPersonDist, 6)
		player.CameraMaxZoomDistance = math.max(state.thirdPersonDist + 8, 14)
		local cam = Workspace.CurrentCamera
		if cam then
			cam.CameraType = Enum.CameraType.Custom
		end
	else
		player.CameraMinZoomDistance = originalCameraBounds.MinZoom
		player.CameraMaxZoomDistance = originalCameraBounds.MaxZoom
	end
end

local function applyLightingState()
	if state.noFog then
		Lighting.FogEnd = 1e6
		Lighting.FogStart = 1e6
	else
		Lighting.FogEnd = originalLighting.FogEnd
		Lighting.FogStart = originalLighting.FogStart
	end

	if state.removeShadows then
		Lighting.GlobalShadows = false
	end

	if state.fullBright then
		Lighting.ClockTime = 14
		Lighting.Brightness = 2.5
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(185, 185, 185)
		Lighting.OutdoorAmbient = Color3.fromRGB(185, 185, 185)
	elseif state.brightAmbientSoft then
		Lighting.Brightness = 1.8
		Lighting.Ambient = Color3.fromRGB(130, 130, 130)
		Lighting.OutdoorAmbient = Color3.fromRGB(130, 130, 130)
	elseif state.nightVisionTint then
		Lighting.Ambient = Color3.fromRGB(40, 170, 75)
		Lighting.OutdoorAmbient = Color3.fromRGB(40, 170, 75)
	elseif state.warmVisionTint then
		Lighting.Ambient = Color3.fromRGB(175, 125, 65)
		Lighting.OutdoorAmbient = Color3.fromRGB(175, 125, 65)
	else
		Lighting.ClockTime = originalLighting.ClockTime
		Lighting.Brightness = originalLighting.Brightness
		Lighting.GlobalShadows = originalLighting.GlobalShadows
		Lighting.Ambient = originalLighting.Ambient
		Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
	end

	if state.lowGravityToggle then
		Workspace.Gravity = 75
	elseif state.highGravityToggle then
		Workspace.Gravity = 320
	else
		Workspace.Gravity = 196.2
	end
end

