	{kind="toggle", label="적 궤도 공전", val=state.orbitNearestEnemy, fn=function(v) state.orbitNearestEnemy=v end, info="가장 가까운 적 주변을 원을 그리며 돌아."},
	{kind="toggle", label="적 상시 주시", val=state.autoFaceNearestEnemy, fn=function(v) state.autoFaceNearestEnemy=v end, info="가장 가까운 적 방향으로 내 캐릭터를 계속 돌려."},
	{kind="action", label="가장 가까운 적 이동", bg=Color3.fromRGB(59,130,246), fn=function()
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not myRoot then return end
		local nearestDist, nearestRoot = math.huge, nil
		for _, plr in ipairs(Players:GetPlayers()) do
			if isEnemyForEsp(plr) and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local d = (hrp.Position - myRoot.Position).Magnitude
					if d < nearestDist then nearestDist = d; nearestRoot = hrp end
				end
			end
		end
