		end)
	else
		actionBtn.Text = "  " .. label
		actionBtn.BackgroundColor3 = bgOrCb or Color3.fromRGB(45, 58, 82)
		actionBtn.MouseButton1Click:Connect(cbOrInfo)
		infoBtn.MouseButton1Click:Connect(function()
			showFeatureDetail(label, infoText or "기능 설명")
		end)
	end
end

local function populateList(page, items)
	page.CanvasSize = UDim2.new(0, 0, 0, #items * 28 + 10)
	for i, item in ipairs(items) do
		local y = 5 + (i - 1) * 28
		if item.kind == "toggle" then
			addFeatureRow(page, item.label, y, "toggle", item.val, item.fn, item.info)
		else
			addFeatureRow(page, item.label, y, "action", false, item.bg, item.fn, item.info)
		end
	end
end

