local lastFpsTime = os.clock()
local frameCount = 0
local currentFps = 60

RunService.RenderStepped:Connect(function(dt)
	local cam = Workspace.CurrentCamera
	if not cam then return end

	isMobileTouch = detectMobilePlatform()
	rainbowHue = (rainbowHue + dt * 0.25) % 1

	frameCount += 1
	local now = os.clock()
	if now - lastFpsTime >= 0.5 then
		currentFps = math.floor(frameCount / (now - lastFpsTime))
		frameCount = 0
		lastFpsTime = now
	end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

	applyGodModeStep(myHum)
	updateSpinState(dt, myRoot, myHum)

	if state.thirdPersonHack and myRoot and myHum then
		player.CameraMinZoomDistance = math.max(state.thirdPersonDist, 6)
		player.CameraMaxZoomDistance = math.max(state.thirdPersonDist + 8, 14)
	end

	if state.orbitNearestEnemy and myRoot then
		local nearRoot = nil
		local nearDist = math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			if isEnemyForEsp(plr) and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local h = plr.Character:FindFirstChildOfClass("Humanoid")
				if hrp and h and h.Health > 0 then
					local d = (hrp.Position - myRoot.Position).Magnitude
					if d < nearDist then
						nearDist = d
						nearRoot = hrp
					end
				end
			end
		end
		if nearRoot then
			local ang = now * 5.5
			local offset = Vector3.new(math.cos(ang) * 5.5, 0, math.sin(ang) * 5.5)
			myRoot.CFrame = CFrame.lookAt(nearRoot.Position + offset, nearRoot.Position)
		end
	elseif state.autoFaceNearestEnemy and myRoot then
		local nearRoot = nil
		local nearDist = math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			if isEnemyForEsp(plr) and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local h = plr.Character:FindFirstChildOfClass("Humanoid")
				if hrp and h and h.Health > 0 then
					local d = (hrp.Position - myRoot.Position).Magnitude
					if d < nearDist then
						nearDist = d
						nearRoot = hrp
					end
				end
			end
		end
		if nearRoot then
			local flat = Vector3.new(nearRoot.Position.X - myRoot.Position.X, 0, nearRoot.Position.Z - myRoot.Position.Z)
			if flat.Magnitude > 0.05 then
				myRoot.CFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + flat.Unit)
			end
		end
	end

	local espColor = getEspColor()
	darkShade.Visible = state.darkOverlay
	crosshair.Visible = state.crosshairDot
	chLineH.Visible = state.crosshairPlus
	chLineV.Visible = state.crosshairPlus

	if state.crosshairDynamic and myHum then
		local spreadPx = math.clamp(14 + myHum.MoveDirection.Magnitude * 14, 10, 32)
		chLineH.Size = UDim2.new(0, spreadPx, 0, 2)
		chLineV.Size = UDim2.new(0, 2, 0, spreadPx)
	else
		chLineH.Size = UDim2.new(0, 16, 0, 2)
		chLineV.Size = UDim2.new(0, 2, 0, 16)
	end

	fovCircle.Visible = (state.aimbot or state.sightHeadShoot or state.fastHeadKillMode) and state.showFov
	fovCircle.Size = UDim2.new(0, state.fovRadius * 2, 0, state.fovRadius * 2)
	fovStroke.Color = state.aimFovRainbow and Color3.fromHSV(rainbowHue, 0.9, 1) or Color3.fromRGB(255, 255, 255)

	radarFrame.Visible = state.radarEnabled
	radarFrame.Size = state.radarCompactMode and UDim2.new(0, 92, 0, 92) or UDim2.new(0, 112, 0, 112)
	radarRing.Visible = state.radarShowDistRing
	radarStroke.Color = state.espRadarSyncColor and espColor or Color3.fromRGB(70, 210, 255)

	local baseFov = state.camFovBoost and 100 or 70
	if state.thirdPersonHack then baseFov = math.max(baseFov, 88) end
	if state.thirdPersonPeek then baseFov += 8 end
	cam.FieldOfView = baseFov

	applyLightingState()

	if (state.airFloat or state.safePlatformLock) and myRoot then
		floatPart.Position = myRoot.Position - Vector3.new(0, 3.8, 0)
	else
		floatPart.Position = Vector3.new(0, -500, 0)
	end

	local enemyAliveCount = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemyForEsp(plr) and plr.Character then
			local h = plr.Character:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then enemyAliveCount += 1 end
		end
	end

	alertFlash.Visible = state.screenFlashAlert and (enemyAliveCount > 0)

	hudLabel.Visible = state.fpsHud or state.posHud or state.pingHud or state.enemyCountHud or state.spinStatusHud or state.thirdPersonHack
	if hudLabel.Visible then
		local lines = {}
		if state.fpsHud then table.insert(lines, "FPS:" .. tostring(currentFps)) end
		if state.pingHud then
			local pingMs = math.floor((player:GetNetworkPing() or 0) * 1000)
			table.insert(lines, "PING:" .. tostring(pingMs) .. "ms")
		end
		if state.enemyCountHud then table.insert(lines, "ENEMY:" .. tostring(enemyAliveCount)) end
		if state.spinStatusHud then table.insert(lines, "SPIN:" .. (state.spinHack and "ON" or "OFF")) end
		if state.thirdPersonHack then table.insert(lines, "3RD:ON") end
		if state.posHud and myRoot then
			table.insert(lines, string.format("POS:%.0f,%.0f,%.0f", myRoot.Position.X, myRoot.Position.Y, myRoot.Position.Z))
		end
		hudLabel.Text = " " .. table.concat(lines, " | ")
	end

	local vpSize = cam.ViewportSize
	local tracerOrigin = state.tracerTopMode and Vector2.new(vpSize.X * 0.5, 0)
		or (state.tracerCenterMode and Vector2.new(vpSize.X * 0.5, vpSize.Y * 0.5)
		or Vector2.new(vpSize.X * 0.5, vpSize.Y))

	for _, plr in ipairs(Players:GetPlayers()) do
		local v = getVisual(plr)
		local blip = getRadarBlip(plr)
		local enemy = isEnemyForEsp(plr)
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local head = char and char:FindFirstChild("Head")
		local alive = hum and hum.Health > 0

		local inRange = true
		if state.espMaxDistFilter and hrp and myRoot then
			inRange = ((hrp.Position - myRoot.Position).Magnitude <= 160)
		end

		local visOk = true
		if state.espOnlyVisible and head then
			visOk = isPartVisible(cam, head.Position, char)
		end

		if state.radarEnabled and enemy and hrp and myRoot and alive and inRange then
			local rel = hrp.Position - myRoot.Position
			if state.radarRotateWithCam then
				local look = cam.CFrame.LookVector
				local yaw = math.atan2(-look.X, -look.Z)
				local cosY, sinY = math.cos(yaw), math.sin(yaw)
				rel = Vector3.new(rel.X * cosY - rel.Z * sinY, 0, rel.X * sinY + rel.Z * cosY)
			end
			local radHalf = radarFrame.AbsoluteSize.X * 0.44
			local scale = radHalf / math.max(state.radarRange, 20)
			local rx = math.clamp(rel.X * scale, -radHalf, radHalf)
			local rz = math.clamp(rel.Z * scale, -radHalf, radHalf)
			blip.Position = UDim2.new(0.5, rx, 0.5, rz)
			blip.Size = state.radarBlipSizeBoost and UDim2.new(0, 9, 0, 9) or UDim2.new(0, 6, 0, 6)
			blip.BackgroundColor3 = espColor
			blip.Visible = true
		else
			blip.Visible = false
		end

		if enemy and char and hrp and head and (alive or not state.espHideDead) and inRange and visOk then
			v.boxStroke.Color = espColor
			v.boxStroke.Thickness = state.skeletonThick and 2.1 or 1.3
			v.box.BackgroundTransparency = state.boxFillEsp and 0.82 or 1
			v.box.BackgroundColor3 = espColor
			v.headStroke.Color = espColor
			v.hl.FillColor = espColor
			v.hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			v.hl.FillTransparency = state.chamsPulse and (0.45 + math.sin(now * 6) * 0.2) or 0.55
			v.hl.Adornee = char
			v.hl.Enabled = state.esp3D

			local topWorld, topOn = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.85, 0))
			local botWorld, botOn = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.0, 0))
			local centerWorld, centerOn = cam:WorldToViewportPoint(hrp.Position)

			local rawHeight = math.abs(topWorld.Y - botWorld.Y)
			local boxHeight = math.clamp(rawHeight, 12, 440)
			local boxWidth = math.clamp(boxHeight * 0.54, 10, 240)

			if state.esp2D and (topOn or botOn or centerOn) and centerWorld.Z > 0 then
				local cx = (topWorld.X + botWorld.X) * 0.5
				local topY = math.min(topWorld.Y, botWorld.Y)
				v.box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
				v.box.Position = UDim2.new(0, cx - boxWidth * 0.5, 0, topY)
				v.box.Visible = true

				v.hpBg.Visible = state.healthBar
				if state.healthBar and hum then
					local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
					v.hpFill.Size = UDim2.new(1, 0, ratio, 0)
				end

				local parts = {}
				if state.showName then table.insert(parts, plr.DisplayName) end
				if state.healthTextEsp and hum then table.insert(parts, math.floor(hum.Health) .. "HP") end
				if state.showDistance and myRoot then table.insert(parts, math.floor((hrp.Position - myRoot.Position).Magnitude) .. "m") end
				if state.espShowToolName then
					local t = char:FindFirstChildOfClass("Tool")
					if t then table.insert(parts, "[" .. t.Name .. "]") end
				end
				if state.lookingAtMeEsp and myRoot then
					local lookDiff = (myRoot.Position - hrp.Position).Unit:Dot(hrp.CFrame.LookVector)
					if lookDiff > 0.85 then table.insert(parts, "!AIM!") end
				end
				v.tag.Text = table.concat(parts, " ")
				v.tag.Visible = (#parts > 0)
			else
				v.box.Visible = false
			end

			if state.tracers and centerOn and centerWorld.Z > 0 then
				updateLine(v.tracer, tracerOrigin, Vector2.new(centerWorld.X, centerWorld.Y), state.skeletonThick and 2 or 1.2, espColor)
			else
				v.tracer.Visible = false
			end

			if state.skeleton then
				local headVP, headOn = cam:WorldToViewportPoint(head.Position)
				if headOn and headVP.Z > 0 and state.headDotEsp then
					local radiusPx = math.clamp(rawHeight * 0.065, 2, 9)
					v.headCircle.Size = UDim2.new(0, radiusPx * 2, 0, radiusPx * 2)
					v.headCircle.Position = UDim2.new(0, headVP.X, 0, headVP.Y)
					v.headCircle.Visible = true
				else
					v.headCircle.Visible = false
				end

				local isR15 = char:FindFirstChild("UpperTorso") ~= nil
				local pairsList = isR15 and BONE_PAIRS_R15 or BONE_PAIRS_R6
				local boneIdx = 1
				for _, pair in ipairs(pairsList) do
					if boneIdx <= #v.bones then
						local pA = char:FindFirstChild(pair[1])
						local pB = char:FindFirstChild(pair[2])
						if pA and pA:IsA("BasePart") and pB and pB:IsA("BasePart") then
							local sA, onA = cam:WorldToViewportPoint(pA.Position)
							local sB, onB = cam:WorldToViewportPoint(pB.Position)
							if (onA or onB) and sA.Z > 0 and sB.Z > 0 then
								updateLine(v.bones[boneIdx], Vector2.new(sA.X, sA.Y), Vector2.new(sB.X, sB.Y), state.skeletonThick and 2.1 or 1.3, espColor)
								boneIdx += 1
							end
						end
					end
				end
				for i = boneIdx, #v.bones do v.bones[i].Visible = false end
			else
				v.headCircle.Visible = false
				for _, b in ipairs(v.bones) do b.Visible = false end
			end
		else
			hideVisual(v)
		end
	end
end)

RunService:BindToRenderStep("OllieAimbotAndSightHead", Enum.RenderPriority.Camera.Value + 5, function()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	hasActiveSightTarget = false

	if state.sightHeadShoot or state.fastHeadKillMode or state.spinHack then
		local sightHead = getNearestHeadInScreenSight()
		if sightHead then
			hasActiveSightTarget = true
			local targetPos = getPredictedPos(sightHead, sightHead.Parent and sightHead.Parent:FindFirstChild("HumanoidRootPart"))
			local camPos = cam.CFrame.Position
			cam.CFrame = CFrame.new(camPos, targetPos)
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if myRoot then
				local flatDir = Vector3.new(targetPos.X - myRoot.Position.X, 0, targetPos.Z - myRoot.Position.Z)
				if flatDir.Magnitude > 0.05 then
					myRoot.CFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + flatDir.Unit)
				end
			end
			if state.autoFireWhenAimed or state.fastHeadKillMode then
				triggerFireAction()
			end
			return
		end
	end

	if state.triggerBot then
		local centerHead = getNearestHeadInScreenSight()
		if centerHead then
			local vp = cam.ViewportSize
			local sp = cam:WorldToViewportPoint(centerHead.Position)
			local distCenter = (Vector2.new(sp.X, sp.Y) - Vector2.new(vp.X * 0.5, vp.Y * 0.5)).Magnitude
			if distCenter <= 28 then
				triggerFireAction()
			end
		end
	end

	if state.aimbot then
		local target = getBestAimTarget()
		if target then
			local targetPos = getPredictedPos(target, target.Parent and target.Parent:FindFirstChild("HumanoidRootPart"))
			local camPos = cam.CFrame.Position
			local lookCFrame = CFrame.lookAt(camPos, targetPos)
			local smoothFactor = (state.aimSnapBoost or state.fastHeadKillMode) and 0.96 or math.clamp(state.aimSmooth, 0.05, 1)
			local blendedLook = cam.CFrame.LookVector:Lerp(lookCFrame.LookVector, smoothFactor).Unit
			cam.CFrame = CFrame.new(camPos, camPos + blendedLook)
			if state.autoFireWhenAimed or state.fastHeadKillMode then
				triggerFireAction()
			end
		end
	end
end)

RunService:BindToRenderStep("OllieSpinLateApply", Enum.RenderPriority.Camera.Value + 10, function()
	if not state.spinHack or hasActiveSightTarget then return end
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local myHum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if state.spinOnlyWhenMoving and myHum and myHum.MoveDirection.Magnitude < 0.05 then return end
	if myRoot and (not myHum or not myHum.Sit) then
		local pos = myRoot.Position
		local vel = myRoot.AssemblyLinearVelocity
		local extraPitch = state.spinWobblePitch and (math.sin(os.clock() * 14) * 0.12) or 0
		myRoot.CFrame = CFrame.new(pos) * CFrame.Angles(extraPitch, spinAngleAccum, 0)
		myRoot.AssemblyLinearVelocity = vel
	end
end)

