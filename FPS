local function getPredictedPos(part, hrp)
	if not part then return Vector3.zero end
	if state.aimPredictMove and hrp then
		return part.Position + (hrp.AssemblyLinearVelocity * 0.08)
	end
	return part.Position
end

local function getBestAimTarget()
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
	local bestPart = nil
	local bestScore = math.huge

	if state.aimStickTarget and currentLockedTarget and currentLockedTarget.Parent then
		local ownerPlr = Players:GetPlayerFromCharacter(currentLockedTarget.Parent)
		if ownerPlr and not isEnemyForAim(ownerPlr) then
			currentLockedTarget = nil
		else
			local hum = currentLockedTarget.Parent:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local vp, onScreen = cam:WorldToViewportPoint(currentLockedTarget.Position)
				if onScreen and vp.Z > 0 then
					local d = (Vector2.new(vp.X, vp.Y) - center).Magnitude
					if d <= state.fovRadius * 1.35 then
						return currentLockedTarget
					end
				end
			end
			currentLockedTarget = nil
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemyForAim(plr) and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local part = state.aimHead
				and (plr.Character:FindFirstChild("Head") or hrp)
				or (hrp or plr.Character:FindFirstChild("Head"))
			if hum and hum.Health > 0 and part then
				local vp, onScreen = cam:WorldToViewportPoint(part.Position)
				if onScreen and vp.Z > 0 then
					local d = (Vector2.new(vp.X, vp.Y) - center).Magnitude
					if d <= state.fovRadius then
						local score = d
						if state.aimLowestHp then
							score = hum.Health + d * 0.3
						elseif state.aimNearestWorld and hrp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
							score = (hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude
						end
						if score < bestScore then
							bestScore = score
							bestPart = part
						end
					end
				end
			end
		end
	end

	currentLockedTarget = bestPart
	return bestPart
end

local function getNearestHeadInScreenSight()
	local cam = Workspace.CurrentCamera
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not cam or not myRoot then return nil end

	local vp = cam.ViewportSize
	local bestHead = nil
	local bestWorldDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemyForAim(plr) and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local head = plr.Character:FindFirstChild("Head")
			if hum and hum.Health > 0 and head then
				local screenPos, onScreen = cam:WorldToViewportPoint(head.Position)
				if onScreen and screenPos.Z > 0 and screenPos.X >= 0 and screenPos.X <= vp.X and screenPos.Y >= 0 and screenPos.Y <= vp.Y then
					local worldDist = (head.Position - myRoot.Position).Magnitude
					if worldDist < bestWorldDist then
						bestWorldDist = worldDist
						bestHead = head
					end
				end
			end
		end
	end
	return bestHead
end

local function equipFirstToolIfNeeded()
	if not state.autoEquipTool then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if char and hum and not char:FindFirstChildOfClass("Tool") then
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			local tool = backpack:FindFirstChildOfClass("Tool")
			if tool then
				pcall(function()
					hum:EquipTool(tool)
				end)
			end
		end
	end
end

local function triggerFireAction()
	local minInterval = (state.fastHeadKillMode or state.rapidFireClick) and 0.025 or 0.065
	local now = os.clock()
	if now - lastShotTick < minInterval then return end
	lastShotTick = now

	equipFirstToolIfNeeded()

	local char = player.Character
	if char then
		local tool = char:FindFirstChildOfClass("Tool")
		if tool and typeof(tool.Activate) == "function" then
			pcall(function()
				tool:Activate()
			end)
		end
	end

	if not isMobileTouch then
		pcall(function()
			local cam = Workspace.CurrentCamera
			local cx = cam and (cam.ViewportSize.X * 0.5) or 400
			local cy = cam and (cam.ViewportSize.Y * 0.5) or 300
			VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
			task.defer(function()
				pcall(function()
					VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
				end)
			end)
		end)
	end
end

local function updateSpinState(dt, myRoot, hum)
	if not state.spinHack or not myRoot or hasActiveSightTarget then return end
	if hum and hum.Sit then return end
	if state.spinOnlyWhenMoving and hum and hum.MoveDirection.Magnitude < 0.05 then return end

	spinDirSign = state.spinReverseDir and -1 or 1
	spinAngleAccum = (spinAngleAccum + (state.spinSpeed * spinDirSign) * dt) % (math.pi * 2)
	local pos = myRoot.Position
	local vel = myRoot.AssemblyLinearVelocity
	local extraPitch = state.spinWobblePitch and (math.sin(os.clock() * 14) * 0.12) or 0
	myRoot.CFrame = CFrame.new(pos) * CFrame.Angles(extraPitch, spinAngleAccum, 0)
	myRoot.AssemblyLinearVelocity = vel
end

local function applyGodModeStep(hum)
	if not state.godMode or not hum then return end
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		if hum.MaxHealth < 1e6 then
			hum.MaxHealth = 1e6
		end
		if hum.Health < hum.MaxHealth then
			hum.Health = hum.MaxHealth
		end
		if hum:GetState() == Enum.HumanoidStateType.Dead then
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end
	end)
end

local function applySkinByName(skinName)
	local char = player.Character
	if not char or not skinName then return end
	local hue = ((#skinName * 41) % 360) / 360
	local col = Color3.fromHSV(hue, 0.5, 0.92)
	for _, p in ipairs(char:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			p.Color = col
		end
	end
end

