local function detectMobilePlatform()
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(854, 480)
	local hasTouch = UserInputService.TouchEnabled
	local hasAccel = UserInputService.AccelerometerEnabled
	local hasGyro = UserInputService.GyroscopeEnabled
	local noPhysicalKeyboard = not UserInputService.KeyboardEnabled
	local isSmallTouchScreen = hasTouch and (math.max(vp.X, vp.Y) <= 1366)
	return (hasTouch and (noPhysicalKeyboard or hasAccel or hasGyro or isSmallTouchScreen))
end

